#!/usr/bin/env python3
"""cfoperator — the operator-facing command.

    cfoperator init [--non-interactive] [--validate-only] [--dir DIR]
        Validated, discovery-driven config generation (CFOP-45). Probes every
        answer as it is given and writes config.yaml + .env.

A dispatcher only, so `cfoperator <verb>` can grow without this file becoming
a second place behaviour lives; each verb is its own module.
"""

import os
import sys

# Runnable from anywhere, not just the repo root: the verbs import repo
# modules (setup_wizard, cfshared) by bare name.
#
# Two entries, because the verbs' modules no longer all sit beside this file:
# the repo root for packages like cfshared, and scripts/ for the verb modules
# themselves (setup_wizard moved there when the root was cleared of loose
# files). Both are needed — dropping the second makes `cfoperator init` fail
# with ModuleNotFoundError at the import below.
_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _HERE)
sys.path.insert(1, os.path.join(_HERE, "scripts"))


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if not argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    verb, rest = argv[0], argv[1:]
    if verb == "init":
        import setup_wizard

        return setup_wizard.main(rest)
    print(f"cfoperator: unknown command {verb!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
