# CFOperator Configuration — getting started
# Copy to config.yaml and fill in the URLs for your own stack.
#
# This is a complete config, not an excerpt. Every setting not named here has a
# default, and your file is merged over those defaults rather than replacing
# them — so you write down your endpoints and your choices, and nothing else.
# The default schema is cfshared/config.py; the annotated reference for every
# option (SSH host inventory, Timescale, MCP, Slack Socket Mode, the
# deep-investigation tier, remediation, git repo mapping) is
# docs/config-reference.md.
#
# No host inventory is required. Workloads are discovered from the Kubernetes
# API and from Prometheus targets at runtime; a static inventory is an optional
# overlay for hybrid fleets, documented in the reference.

# How much CFOperator is allowed to do.
#   investigate  observe, triage, investigate, notify. Never proposes a change.
#   remediate    additionally lets the remediation queue, executor and
#                pull-request flags in docs/config-reference.md take effect.
# Setting this to `investigate` forces those flags off no matter what else
# (including the operator console) says. Omitting the key entirely leaves the
# flags exactly as written, which is what configs predating this key expect.
profile: investigate

# LLM. Short form of llm.primary — the fallback chain and the embeddings model
# are in the reference. Shipped providers: ollama, groq, xai, gemini,
# deepseek, anthropic.
llm:
  backend: ollama
  url: http://localhost:11434
  model: qwen3:14b/no_think   # /no_think disables deliberative mode
  # Optional dedicated triage classifier (an ollama model tag, served from the
  # same URL as the primary). When set, alert triage tries this model first and
  # falls back to the normal provider chain on any failure or unparseable
  # response; when unset, triage uses the primary chain unchanged. Meant for a
  # small fine-tuned model that answers the triage rubric fast; investigations
  # are unaffected. The console Admin -> LLM tab can override this live
  # (DB over config; 'off' there disables despite this key). (CFOP-57/58)
  # triage_model: cfop-triage-ministral3:v1-q4

# Metrics. Shipped backend: prometheus.
prometheus:
  url: http://prometheus:9090

# Alert ingest. Shipped backend: alertmanager.
alertmanager:
  url: http://alertmanager:9093

# Logs — optional. Delete this block and log queries are simply unavailable;
# nothing else changes. Shipped backend: loki.
loki:
  url: http://loki:3100

# Where triage sends 'notify'. Any subset of these; a blank value is skipped, so
# an unset variable leaves that sink off rather than half-configured.
# Shipped sinks: slack, discord, ntfy.
notify:
  slack_webhook: ${SLACK_WEBHOOK_URL}
  # discord_webhook: ${DISCORD_WEBHOOK_URL}
  # ntfy_url: ${NTFY_URL}
  # ntfy_topic: ${NTFY_TOPIC}

# Knowledge base. Host, port, database and user default to
# postgres:5432/cfoperator; only the password has to be supplied (and it also
# falls back to POSTGRES_PASSWORD if you leave this out entirely).
database:
  password: ${POSTGRES_PASSWORD}

# Container runtime. Left unset, CFOperator uses the Kubernetes API when it can
# see it is running inside a cluster, and no container backend otherwise. Set it
# explicitly for bare-metal Docker or a mixed fleet:
#
# observability:
#   containers:
#     - backend: kubernetes
#     - backend: docker
#       hosts:
#         local: unix:///var/run/docker.sock
