# CFOperator Environment Variables
# Copy this to .env and fill in your values

# Observability
PROMETHEUS_URL=http://your-prometheus-host:9090
LOKI_URL=http://your-loki-host:3100
ALERTMANAGER_URL=http://your-alertmanager-host:9093

# Database
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=cfoperator
POSTGRES_USER=cfoperator
POSTGRES_PASSWORD=your-secure-password-here

# event_runtime HTTP surface: bearer token for POST /alert and the /history,
# /activity, /scheduled, /jobs read endpoints. Unset = those routes are open.
CFOP_RUNTIME_TOKEN=

# Telemetry TimescaleDB (optional) — enables the `timescale_query` tool and the
# mqtt-top-talkers skill. Without TIMESCALE_PASSWORD the tool is not registered.
# Point TIMESCALE_USER at a read-only role; the tool also forces a read-only
# transaction and rejects anything that isn't a single SELECT/WITH.
TIMESCALE_HOST=timescaledb.data.svc.cluster.local
TIMESCALE_PORT=5432
TIMESCALE_DB=sensors
TIMESCALE_USER=cfoperator_ro
TIMESCALE_PASSWORD=

# Console auth (:8083) — see docs/auth.md
# Signs session cookies; without it sessions break on restart and across replicas.
CFOP_SESSION_SECRET=
# Bootstrap credentials for the first admin. Once a real admin exists in
# auth_users these are a no-op and can be removed.
CFOP_UI_USERNAME=
CFOP_UI_PASSWORD_HASH=
# Per-service bearer token. In production each service mounts its OWN token
# from auth_api_tokens as this variable; the shared credential that used to
# live here was retired 2026-08-09. Leave unset unless you are running a
# service locally against a real agent — setting it in the agent's own env
# re-enables a shared credential that belongs to no user and cannot be revoked
# individually. Mint per-service tokens at /tokens.
CFOP_API_TOKEN=
# Opens the console entirely. Local docker-compose only — logs a loud warning.
CFOP_AUTH_DISABLED=

# GitHub
GITHUB_TOKEN=

# LLM API Keys (optional — only needed for fallback providers)
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Notifications (optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# ntfy: triage 'notify' action -> phone. Both required to enable the sink.
# Topic is the only access control on a public ntfy server — keep it unguessable.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# Optional overrides (JSON for the maps): NTFY_TITLE, NTFY_TIMEOUT,
# NTFY_DEFAULT_PRIORITY, NTFY_PRIORITY_MAP, NTFY_TAGS_MAP
