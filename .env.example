# CFOperator Environment Variables
# Copy this to .env and fill in your values

# Observability
PROMETHEUS_URL=http://your-prometheus-host:9090
LOKI_URL=http://your-loki-host:3100
ALERTMANAGER_URL=http://your-alertmanager-host:9093

# Database
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=cfoperator
POSTGRES_USER=cfoperator
POSTGRES_PASSWORD=your-secure-password-here

# GitHub
GITHUB_TOKEN=

# LLM API Keys (optional — only needed for fallback providers)
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Notifications (optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# ntfy: triage 'notify' action -> phone. Both required to enable the sink.
# Topic is the only access control on a public ntfy server — keep it unguessable.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# Optional overrides (JSON for the maps): NTFY_TITLE, NTFY_TIMEOUT,
# NTFY_DEFAULT_PRIORITY, NTFY_PRIORITY_MAP, NTFY_TAGS_MAP
