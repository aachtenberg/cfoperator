# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
*.egg-info/
dist/
build/

# Config — the operator's live site config, which is never committed. The
# pattern is unanchored, so it also matches nested paths: the compose trial's
# starter config is a shipped artifact and has to be excepted explicitly, or a
# fresh clone has nothing to bind-mount and the stack fails to start.
config.yaml
!deploy/compose/config.yaml
.env
*.secret
secrets/
.claude/*.local.json
.claude/secrets.local.json

# IDE
.vscode/
.idea/
.continue/
*.swp
*.swo

# Misc non-project files
linkinpost
CONTINUE_QUICKREF.md

# Logs
*.log

# Database
*.db
*.sqlite

# Certificates & keys
*.pem
*.key
*.p12
*.der

# OS
.DS_Store
Thumbs.db
.venv-test/

# Generated by test_tool_calling.py when run as a script (regenerable output,
# not source). Kept out of the tree so a benchmark run does not dirty the repo.
tool_calling_results.json
sweep_comparison_results.json
